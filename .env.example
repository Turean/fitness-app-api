# Copy this file to .env before running the API for the first time:
#
#   cp .env.example .env
#
# .env is gitignored; this file is the tracked template. Both are read
# by dotenv — prisma.config.ts and lib/prisma.ts import "dotenv/config".

# Local SQLite database, relative to the api/ directory. Created by
# `npx prisma migrate dev`; it is not in the repo.
DATABASE_URL="file:./dev.db"

# Signs and verifies auth tokens. Generate your own — do not reuse a
# value from anywhere else, and never commit the filled-in .env:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
